{
  "name": "centro-dental-innovador",
  "version": "1.3.0",
  "description": "App de escritorio (React + Vite + Electron) con splash 2s, ventana maximizada y scripts robustos para Windows",
  "main": "electron.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && node node_modules/electron/cli.js .\"",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "start": "node node_modules/electron/cli.js .",
    "dist": "vite build && electron-builder",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview --host",
    "predeploy": "npm run web:build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@cliniqone/audio-engine": "file:vendor/f1/audio-engine",
    "@cliniqone/f1-voice-engine": "file:vendor/f1/sdk",
    "@cliniqone/onnx-runtime": "file:vendor/f1/runtime",
    "@cliniqone/vad": "file:vendor/f1/vad",
    "@cliniqone/wake-detector": "file:vendor/f1/wake-detector",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.253.0",
    "multer": "^1.4.5-lts.1",
    "onnxruntime-web": "1.22.0",
    "pg": "^8.16.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.11",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.0",
    "electron": "^26.1.0",
    "electron-builder": "^24.6.0",
    "gh-pages": "^6.3.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.3.0",
    "vite": "^5.4.21",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.centrodental.innovador",
    "productName": "Centro Dental Innovador",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js",
      "icon.ico",
      "splash.html",
      "assets/**/*"
    ]
  }
}
