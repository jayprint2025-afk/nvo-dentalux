function getFbPageToken(pageId) {
  const pid = String(pageId || '').trim();
  if (FB_PAGE_TOKENS_JSON) {
    try {
      const map = JSON.parse(FB_PAGE_TOKENS_JSON);
      const tok = map && map[pid];
      if (tok) return String(tok);
    } catch (e) {
